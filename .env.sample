SECRET_KEY=local-only-replace-with-a-long-random-secret-key
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=planetarium
POSTGRES_USER=planetarium
POSTGRES_PASSWORD=local-only-change-me
# Set POSTGRES_HOST=localhost to use a local PostgreSQL server.
# Leave unset for SQLite. Docker Compose sets it to db automatically.
