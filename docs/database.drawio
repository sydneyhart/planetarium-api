<mxfile host="app.diagrams.net" version="29.0.0"><diagram id="planetarium-db" name="Planetarium database"><mxGraphModel dx="1450" dy="950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1000" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="PLANETARIUM / DATABASE STRUCTURE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=29;fontColor=#102a43;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="18" width="1200" height="50" /></mxCell><mxCell id="subtitle" value="Django REST Framework · PostgreSQL · Seat-level reservations and cancellation history" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="65" width="1300" height="30" /></mxCell><mxCell id="user" value="User" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;horizontal=1;fillColor=#17354f;swimlaneFillColor=#f4f8fb;strokeColor=#728fa6;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="125" width="280" height="205" /></mxCell><mxCell id="user-fields" value="PK id: bigint&lt;br&gt;email: unique, case insensitive&lt;br&gt;password: hashed&lt;br&gt;first_name, last_name&lt;br&gt;is_staff, is_active" style="text;html=1;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243b53;" vertex="1" parent="user"><mxGeometry as="geometry" x="0" y="38" width="280" height="167" /></mxCell><mxCell id="show" value="AstronomyShow" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;horizontal=1;fillColor=#17354f;swimlaneFillColor=#f4f8fb;strokeColor=#728fa6;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="125" width="300" height="205" /></mxCell><mxCell id="show-fields" value="PK id: bigint&lt;br&gt;title, description&lt;br&gt;duration: minutes &gt; 0&lt;br&gt;age_limit, image&lt;br&gt;themes: M:N → AstronomyTheme" style="text;html=1;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243b53;" vertex="1" parent="show"><mxGeometry as="geometry" x="0" y="38" width="300" height="167" /></mxCell><mxCell id="dome" value="PlanetariumDome" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;horizontal=1;fillColor=#17354f;swimlaneFillColor=#f4f8fb;strokeColor=#728fa6;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="125" width="280" height="180" /></mxCell><mxCell id="dome-fields" value="PK id: bigint&lt;br&gt;name: unique&lt;br&gt;rows &gt; 0, seats_in_row &gt; 0&lt;br&gt;capacity = rows × seats_in_row" style="text;html=1;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243b53;" vertex="1" parent="dome"><mxGeometry as="geometry" x="0" y="38" width="280" height="142" /></mxCell><mxCell id="theme" value="AstronomyTheme" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;horizontal=1;fillColor=#17354f;swimlaneFillColor=#f4f8fb;strokeColor=#728fa6;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1160" y="125" width="270" height="125" /></mxCell><mxCell id="theme-fields" value="PK id: bigint&lt;br&gt;name: unique" style="text;html=1;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243b53;" vertex="1" parent="theme"><mxGeometry as="geometry" x="0" y="38" width="270" height="87" /></mxCell><mxCell id="join" value="Show themes (Django join)" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;horizontal=1;fillColor=#17354f;swimlaneFillColor=#f4f8fb;strokeColor=#728fa6;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1160" y="365" width="270" height="165" /></mxCell><mxCell id="join-fields" value="PK id: bigint&lt;br&gt;FK astronomyshow_id&lt;br&gt;FK astronomytheme_id&lt;br&gt;unique(show, theme)" style="text;html=1;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243b53;" vertex="1" parent="join"><mxGeometry as="geometry" x="0" y="38" width="270" height="127" /></mxCell><mxCell id="reservation" value="Reservation" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;horizontal=1;fillColor=#17354f;swimlaneFillColor=#f4f8fb;strokeColor=#728fa6;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="450" width="280" height="215" /></mxCell><mxCell id="reservation-fields" value="PK id: bigint&lt;br&gt;FK user_id → User (PROTECT)&lt;br&gt;created_at&lt;br&gt;status: confirmed / cancelled&lt;br&gt;total = sum(ticket unit_price)" style="text;html=1;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243b53;" vertex="1" parent="reservation"><mxGeometry as="geometry" x="0" y="38" width="280" height="177" /></mxCell><mxCell id="session" value="ShowSession" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;horizontal=1;fillColor=#17354f;swimlaneFillColor=#f4f8fb;strokeColor=#728fa6;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="450" width="300" height="245" /></mxCell><mxCell id="session-fields" value="PK id: bigint&lt;br&gt;FK astronomy_show_id (PROTECT)&lt;br&gt;FK planetarium_dome_id (PROTECT)&lt;br&gt;show_time: timezone-aware&lt;br&gt;price &gt;= 0 · USD&lt;br&gt;end_time = start + duration" style="text;html=1;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243b53;" vertex="1" parent="session"><mxGeometry as="geometry" x="0" y="38" width="300" height="207" /></mxCell><mxCell id="ticket" value="Ticket" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;horizontal=1;fillColor=#17354f;swimlaneFillColor=#f4f8fb;strokeColor=#728fa6;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="450" width="280" height="245" /></mxCell><mxCell id="ticket-fields" value="PK id: bigint&lt;br&gt;FK reservation_id (CASCADE)&lt;br&gt;FK show_session_id (PROTECT)&lt;br&gt;row, seat: 1-based&lt;br&gt;unit_price: captured at booking&lt;br&gt;is_active: released on cancellation" style="text;html=1;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243b53;" vertex="1" parent="ticket"><mxGeometry as="geometry" x="0" y="38" width="280" height="207" /></mxCell><mxCell id="e1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#486581;endArrow=ERmany;startArrow=ERone;fontColor=#334e68;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="reservation"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#486581;endArrow=ERmany;startArrow=ERone;fontColor=#334e68;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="show" target="session"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#486581;endArrow=ERmany;startArrow=ERone;fontColor=#334e68;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dome" target="session"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="940" y="380" /><mxPoint x="700" y="380" /></Array></mxGeometry></mxCell><mxCell id="e4" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#486581;endArrow=ERmany;startArrow=ERone;fontColor=#334e68;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="session" target="ticket"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#486581;endArrow=ERmany;startArrow=ERone;fontColor=#334e68;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reservation" target="ticket"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="180" y="765" /><mxPoint x="940" y="765" /></Array></mxGeometry></mxCell><mxCell id="e6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#486581;endArrow=ERmany;startArrow=ERone;fontColor=#334e68;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="theme" target="join"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#486581;endArrow=ERmany;startArrow=ERone;fontColor=#334e68;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="show" target="join"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="740" y="350" /><mxPoint x="1125" y="350" /><mxPoint x="1125" y="440" /></Array></mxGeometry></mxCell><mxCell id="rule1" value="Seat integrity: unique (show_session, row, seat) WHERE is_active = true. PostgreSQL row locks serialize competing bookings." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="825" width="1390" height="45" /></mxCell><mxCell id="rule2" value="Cancellation preserves ticket history and original prices, releases active seats, and is allowed only before every booked session starts." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="880" width="1390" height="45" /></mxCell><mxCell id="rule3" value="Scheduling integrity: overlapping sessions in the same dome are rejected. Scheduled show duration and dome layouts are protected." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#243b53;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="935" width="1390" height="35" /></mxCell></root></mxGraphModel></diagram></mxfile>